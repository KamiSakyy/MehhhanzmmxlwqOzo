<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MehhanzStudio" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/mmx_accent</item>
        <item name="android:colorPrimaryDark">@color/mmx_bg</item>
        <item name="android:colorAccent">@color/mmx_accent</item>
        <item name="android:windowBackground">@color/mmx_bg</item>
        <item name="android:statusBarColor">@color/mmx_bg</item>
        <item name="android:navigationBarColor">@color/mmx_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/mmx_text</item>
        <item name="android:textColorSecondary">@color/mmx_text_dim</item>
        <item name="android:textColorHint">@color/mmx_text_dim</item>
        <item name="android:colorControlActivated">@color/mmx_accent</item>
    </style>
    <style name="Theme.MehhanzStudio.Splash">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
    <style name="MmxCard">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    <style name="MmxButton">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/mmx_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="MmxButtonGhost" parent="MmxButton">
        <item name="android:background">@drawable/btn_ghost_bg</item>
        <item name="android:textColor">@color/mmx_accent</item>
    </style>
</resources>
